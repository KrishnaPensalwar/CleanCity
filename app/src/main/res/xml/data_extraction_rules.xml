<?xml version="1.0" encoding="utf-8"?>
<!--
  Exclude auth session storage from cloud backup and device transfer (API 31+).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="auth_prefs_encrypted.xml" />
        <exclude domain="sharedpref" path="auth_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="auth_prefs_encrypted.xml" />
        <exclude domain="sharedpref" path="auth_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
